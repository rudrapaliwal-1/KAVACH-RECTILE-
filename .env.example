# Phase 5 local demo configuration. Put real secrets in your environment or secret manager.
SENTINEL_ENV=demo
SENTINEL_DB_PATH=backend/sentinel.db
SENTINEL_SOURCE_ROOT=verification/lab
SENTINEL_PROTECTED_TESTS_ROOT=verification/protected_tests
SENTINEL_AGENT_CALLABLE=agent.planner:propose_patch
SENTINEL_VERIFIER_CALLABLE=verification.adapter:verify_backend_patch
SENTINEL_FRONTEND_ORIGIN=http://localhost:5173
SENTINEL_OPERATOR_NAME=local-operator
# SENTINEL_OPERATOR_TOKEN: inject a private 32-256 character value at runtime.
SENTINEL_OLLAMA_URL=http://127.0.0.1:11434
SENTINEL_MODEL=qwen2.5-coder:7b
SENTINEL_ALLOWED_PATHS=app/access.py
SENTINEL_MAX_ATTEMPTS=3
SENTINEL_CONNECT_TIMEOUT=3
SENTINEL_INFERENCE_TIMEOUT=600
SENTINEL_PLANNER_TIMEOUT_SECONDS=660
SENTINEL_PROVIDER_RETRIES=0
SENTINEL_MAX_TOKENS=400
SENTINEL_MAX_OUTPUT_CHARS=40000
# NEATLOGS_API_KEY: set in the local .env file or process environment for hosted tracing.
NEATLOGS_API_KEY=

# AI Security Analysis is optional. Set only in the server environment; never in frontend variables.
GEMINI_API_KEY=
SENTINEL_AI_MODEL=gemini-3.5-flash-lite

# VibeCI Local Verification & Preflight Configuration
# Optional: Timeout in seconds for individual verification checks (default: 30, max: 120)
VIBECI_TIMEOUT_SECONDS=30
# Optional: Enable runtime smoke probing (default: false)
VIBECI_ENABLE_SMOKE=false
